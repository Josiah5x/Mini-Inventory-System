{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "staticfiles/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "config/wsgi.py"
    }
  ]
}
