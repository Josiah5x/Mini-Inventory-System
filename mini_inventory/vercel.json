{
  "version": 2,
  "functions": {
    "mini_inventory/config/wsgi.py": {
      "runtime": "vercel-python@4.3.0"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "mini_inventory/staticfiles/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "mini_inventory/config/wsgi.py"
    }
  ]
}
